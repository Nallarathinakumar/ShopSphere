# ---------------------------------------------------------------
# ShopSphere environment configuration
# Copy this file to .env.local and edit. NEVER commit .env.local
# Remember: every VITE_* value is bundled into public browser JS.
# Put ONLY non-secret, client-safe values here.
# ---------------------------------------------------------------

# Router: "hash" is safest for GitHub Pages. Use "browser" on Vercel/Netlify.
VITE_ROUTER=hash

# Only needed for GitHub Pages PROJECT sites (https://user.github.io/repo/)
# Must start and end with a slash, e.g. /shopsphere/
VITE_BASE_PATH=/

# Adobe Experience Platform Web SDK
# Set to true once your Tags embed code (or alloy.js) is added to index.html
VITE_ALLOY_ENABLED=false

# The alloy instance name configured in your Tags property (default: alloy)
VITE_ALLOY_INSTANCE=alloy

# Send Adobe Target / personalization requests on view changes
VITE_PERSONALIZATION_ENABLED=false

# Hash email to SHA-256 before putting it in the XDM identityMap
VITE_HASH_EMAIL=true

# Show the floating on-page event debugger
VITE_DEBUG_PANEL=true

# Store name used in XDM + UI
VITE_STORE_NAME=ShopSphere
VITE_CURRENCY=INR
